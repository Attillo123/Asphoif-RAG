APP_ENV=dev
APP_NAME=asphoif-rag
API_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://user:password@mysql:3306/rag
REDIS_URL=redis://redis:6379/0
LOCAL_FILE_ROOT=./data/files
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_SSL=false
OPENSEARCH_INDEX=rag_chunks_v1
OPENSEARCH_READ_ALIAS=rag_chunks_read
OPENSEARCH_WRITE_ALIAS=rag_chunks_write
RETRIEVAL_VERSION=app-hybrid-v1
DENSE_K=5
SPARSE_K=5
FINAL_TOP_K=5
RETRIEVAL_TIMEOUT_SECONDS=3
EMBEDDING_TIMEOUT_SECONDS=5
CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=10
CHAT_IDLE_TIMEOUT_SECONDS=15
CHAT_TOTAL_TIMEOUT_SECONDS=120
CHAT_CONTEXT_MAX_CHARS=12000
PROMPT_VERSION=prompt-v1
RETRIEVAL_CACHE_TTL_SECONDS=1800
EMBEDDING_CACHE_TTL_SECONDS=172800
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_FAILURE_WINDOW_SECONDS=30
CIRCUIT_OPEN_SECONDS=15
CIRCUIT_HALF_OPEN_MAX_CALLS=2
OPENAI_BASE_URL=https://api.example.invalid/v1
OPENAI_API_KEY=replace-me
CHAT_MODEL=chat-model
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_API_KEY=replace-me
QWEN_EMBEDDING_MODEL=qwen-embedding-model
QWEN_EMBEDDING_DIMENSION=1024
RERANK_MODEL=rerank-model
HEALTHCHECK_TIMEOUT_SECONDS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
INGESTION_MAX_FILE_SIZE_BYTES=10485760
INGESTION_CHUNK_SIZE=1000
INGESTION_CHUNK_OVERLAP=150
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_SECONDS=30
INGESTION_WORKER_ID=local-ingestion-worker
