APP_ENV=prod
APP_NAME=asphoif-rag
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost
DATABASE_URL=mysql+pymysql://user:password@your-mysql-host:3306/rag
REDIS_URL=redis://:password@your-redis-host:6379/0
LOCAL_FILE_ROOT=/app/backend/data/files
OPENSEARCH_URL=http://your-opensearch-host:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_SSL=false
OPENSEARCH_INDEX=rag_chunks_v1
OPENSEARCH_READ_ALIAS=rag_chunks_read
OPENSEARCH_WRITE_ALIAS=rag_chunks_write
RETRIEVAL_VERSION=app-hybrid-v1
DENSE_K=5
SPARSE_K=5
FINAL_TOP_K=5
OPENAI_BASE_URL=https://api.example.invalid/v1
OPENAI_API_KEY=replace-me
CHAT_MODEL=chat-model
QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_API_KEY=replace-me
QWEN_EMBEDDING_MODEL=qwen-embedding-model
QWEN_EMBEDDING_DIMENSION=1024
RERANK_MODEL=rerank-model
HEALTHCHECK_TIMEOUT_SECONDS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
EVALUATION_JUDGE_BASE_URL=https://api.example.invalid/v1
EVALUATION_JUDGE_API_KEY=replace-me
EVALUATION_JUDGE_MODEL=judge-model
EVALUATION_JUDGE_PROMPT_VERSION=ragas-default-v1
WORKER_POLL_SECONDS=5
MYSQL_DATABASE=rag
MYSQL_USER=rag
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
FRONTEND_PORT=80
